# --- App ---
APP_NAME=Protake
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./storage/protake.db
# PostgreSQL (production) — swap in a connection string like below, no code changes required:
# DATABASE_URL=postgresql+psycopg://protake:protake@localhost:5432/protake

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage ---
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
THUMBNAIL_DIR=./storage/thumbnails
REPORT_DIR=./storage/reports
MAX_UPLOAD_SIZE_MB=100

# --- AI Assistant (DeepSeek, active) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- AI Assistant (Anthropic Claude, fallback path — see assistant_service.py) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- AI Validation (YOLOv11 / SAM2 via ultralytics) ---
YOLO_MODEL_PATH=yolo11n.pt
# Optional additional fine-tuned models, each run as its own inference pass
# over the same page and merged into one findings list (see
# app/ai/yolo_detector.py). Leave blank to skip.
YOLO_SECONDARY_MODEL_PATH=
YOLO_FURNITURE_MODEL_PATH=
YOLO_ROOMTYPE_MODEL_PATH=
YOLO_CABINET_MODEL_PATH=
SAM_MODEL_PATH=sam2.1_b.pt
AI_VALIDATION_ENABLED=true

# --- OCR (PaddleOCR) ---
OCR_ENABLED=true
OCR_LANG=en
